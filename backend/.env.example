# Copy this file to .env and fill in values

# Server
PORT=4000

# JWT secret - change this to a long random string in production
JWT_SECRET=change_this_secret_in_production

# SMTP (optional). If left blank, emails are just logged to the console
# instead of actually being sent - the app still works fully without this.
# Example for Gmail: use an "App Password", not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
